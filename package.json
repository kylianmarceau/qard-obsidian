{
  "name": "qard-obsidian",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "The study layer for your Obsidian vault.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test-vault": "node scripts/prepare-test-vault.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "obsidian": "latest",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  }
}
